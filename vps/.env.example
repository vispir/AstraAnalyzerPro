# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Trading Mode
# TEST_MODE=true  - только логирует, не открывает реальные сделки
# TEST_MODE=false - открывает реальные сделки в MT5
TEST_MODE=true

# MT5 Configuration (optional, defaults are fine)
# SYMBOL=XAUUSD
# MAGIC_NUMBER=20241121
# DEVIATION=20
# CHECK_INTERVAL=5
