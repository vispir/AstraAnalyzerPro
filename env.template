# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# Получите бесплатный API ключ на: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# AI Gateway настройки (опционально)
# URL может быть с /chat/completions или без (добавится автоматически)
# Пример: AI_GATEWAY_URL=https://api.example.com/v1/chat/completions
# Если не указан, Gateway модель будет недоступна
AI_GATEWAY_URL=
AI_GATEWAY_KEY=

# Trading Configuration (Gold)
YAHOO_SYMBOL=GC=F

# Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=False

# Telegram Bot Configuration (aiogram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Astra Signal Bot (@AstraSignal_Bot) — только BUY/SELL сделки (без анализа и WAIT)
TELEGRAM_BOT_TOKEN_SIGNALS=your_signals_bot_token_here

# Выберите режим работы бота:
# POLLING (для локальной разработки) - бот сам запрашивает обновления, webhook не нужен
USE_TELEGRAM_POLLING=true

# WEBHOOK (для продакшена на Vercel/VPS) - Telegram отправляет обновления на ваш сервер
# Установите USE_TELEGRAM_POLLING=false и укажите TELEGRAM_WEBHOOK_URL
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/tg/webhook

# Frontend URL (для кнопки в боте)
FRONTEND_URL=http://127.0.0.1:5173

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# OANDA Configuration
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id

# Vercel Cron Secret (для защиты cron endpoint)
CRON_SECRET=your_random_secret_string